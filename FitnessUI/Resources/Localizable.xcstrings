          }
        }
      }
    },
    "Ti stai allenando più del solito (la fascia sicura è 0,8–1,3×): la fatica si accumula prima che la senti.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti stai allenando più del solito (la fascia sicura è 0,8–1,3×): la fatica si accumula prima che la senti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load is above the reference range (0.8–1.3×). Monitor fatigue and adapt your plan."
          }
        }
      }
    },
    "Ti stai allenando meno del solito: settimana di scarico, il corpo recupera.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti stai allenando meno del solito: settimana di scarico, il corpo recupera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load is below your usual range."
          }
        }
      }
    },
    "Carico in linea con quello a cui sei abituato (fascia sicura 0,8–1,3×).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carico in linea con quello a cui sei abituato (fascia sicura 0,8–1,3×)."
