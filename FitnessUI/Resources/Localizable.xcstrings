    "readiness.method": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV (35%) e FC a riposo (20%): confronto con la media degli ultimi 60 giorni; HRV su scala logaritmica. Sonno (25%): da 4,5 ore (0) a 8 ore (10). Carico (20%): ultimi 7 giorni rispetto a 6 settimane; fino a 1,0× vale 10, a 1,3× vale 7,5, da 1,7× vale 0. La fascia abituale è media ± una deviazione standard. Il punteggio rinormalizza i pesi dei dati disponibili e richiede HRV o FC a riposo. È una stima descrittiva, non una valutazione medica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV (35%) and resting HR (20%): compared with your 60-day average; HRV uses a logarithmic scale. Sleep (25%): 4.5 hours scores 0, 8 hours scores 10. Load (20%): last 7 days compared with 6 weeks; up to 1.0× scores 10, 1.3× scores 7.5, and 1.7× or more scores 0. The usual range is mean ± one standard deviation. Available inputs have their weights renormalized; HRV or resting HR is required. This is a descriptive estimate, not a medical assessment."
          }
        }
      }
    },
